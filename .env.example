# Local PostgreSQL — copy to .env and set your credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nziraiq?schema=public"
AUTH_SECRET="nziraiq-dev-secret-change-in-production"
AUTH_TRUST_HOST="true"
# Optional — Copilot falls back to rule-based itineraries without this
OPENAI_API_KEY=""

# Optional OAuth — leave blank to keep Google / Facebook buttons as “not configured”
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
