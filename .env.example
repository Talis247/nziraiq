# Neon / Postgres — pooled URL for the app (use -pooler host on Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooler) URL for Prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
AUTH_TRUST_HOST="true"
# Production site URL (required for stable sessions on Vercel)
AUTH_URL="http://localhost:3000"
# Optional — Copilot falls back to rule-based itineraries without this
OPENAI_API_KEY=""

# Optional OAuth — leave blank to keep Google / Facebook buttons as “not configured”
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
